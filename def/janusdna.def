Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

# =============================================================================
# JanusDNA — Apptainer/Singularity container (no conda required)
#
# Reproduces the janusdna.yml environment using pip only:
#   - Python 3.11, PyTorch 2.8.0 (cu128) — bumped from janusdna.yml's own
#     torch 2.5.0/cu121 because that build has no compiled kernels for
#     Blackwell GPUs (sm_100/sm_120, e.g. RTX PRO 6000 Blackwell) — "CUDA
#     error: no kernel image is available for execution on the device" on
#     the very first op. cu128 is the first PyTorch wheel index with
#     Blackwell kernels baked in; if your GPU is Ampere/Hopper or older,
#     this build still works, just newer than strictly required.
#   - mamba_ssm / causal-conv1d built FROM SOURCE against the installed
#     torch (not a prebuilt wheel — see below for why), targeting Ampere/
#     Hopper/Blackwell (sm_80/86/90/120) so the same .sif runs on any of
#     them. flash-attn is skipped entirely: modeling_janusdna.py imports it
#     in a try/except ImportError and only uses it if config._attn_implementation
#     == "flash_attention_2", but extract_embeddings_JanusDNA.py's build_config()
#     always forces "sdpa" — so it's dead weight (and it's the slowest and
#     most fragile of the three to get an exact ABI match for).
#   - The small set of pure-Python deps actually imported by
#     janusdna/{modeling,configuration}_janusdna.py at runtime (transformers,
#     wandb — modeling_janusdna.py imports it unconditionally even though we
#     never call it) plus mamba_ssm/causal-conv1d's own runtime deps (einops,
#     packaging, ninja, triton), pinned to the versions in JanusDNA's own
#     janusdna.yml — installed inline below, no requirements.txt needed.
#
# BUILD (needs sudo/root or --fakeroot):
#   apptainer build janusdna.sif janusdna.def
#
# RUN (host must have an NVIDIA driver; --nv exposes the GPU):
#   apptainer run  --nv janusdna.sif                 # -> python
#   apptainer exec --nv janusdna.sif python your_script.py
#   apptainer shell --nv janusdna.sif                # interactive shell
#
# Check your GPU's actual compute capability with:
#   apptainer exec --nv janusdna.sif nvidia-smi --query-gpu=name,compute_cap --format=csv
# =============================================================================

%post
    set -eux

    export DEBIAN_FRONTEND=noninteractive

    # ---- System packages -----------------------------------------------------
    apt-get update
    apt-get install -y --no-install-recommends \
        software-properties-common \
        ca-certificates \
        wget curl git \
        build-essential \
        zlib1g-dev libbz2-dev liblzma-dev \
        libcurl4-openssl-dev libssl-dev \
        tabix

    # Python 3.11 (Ubuntu 22.04 ships 3.10 by default)
    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get update
    apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-dev
    rm -rf /var/lib/apt/lists/*

    # ---- Isolated virtualenv --------------------------------------------------
    python3.11 -m venv /opt/venv
    . /opt/venv/bin/activate
    python -m pip install --no-cache-dir --upgrade pip setuptools wheel

    # ---- PyTorch (CUDA 12.8 — needed for Blackwell sm_100/sm_120 kernels) -----
    pip install --no-cache-dir \
        torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0 \
        --index-url https://download.pytorch.org/whl/cu128

    # ---- Build-time deps needed before compiling mamba_ssm/causal-conv1d ------
    # (their setup.py imports packaging/ninja/einops/psutil at build time) +
    # everything else janusdna's modeling/config code and
    # extract_embeddings_JanusDNA.py import at runtime. omegaconf/hydra-core/
    # pytorch-lightning are needed to unpickle the released .ckpt files
    # themselves (torch.load has to import whatever classes were pickled into
    # the checkpoint by JanusDNA's Hydra+Lightning training pipeline, even
    # though we only read out the state_dict). Versions match janusdna.yml.
    # triton==3.4.0, not janusdna.yml's 3.1.0: torch==2.8.0's own PyPI metadata
    # requires triton==3.4.0 exactly, and mamba-ssm==2.3.2.post1's Mamba-3
    # module (new since 2.2.4) calls triton.set_allocator(), which doesn't
    # exist before triton 3.3.0 — 3.1.0 fails with
    # "AttributeError: module 'triton' has no attribute 'set_allocator'".
    # janusdna.yml's 3.1.0 pin was correct only for its own torch==2.5.0.
    pip install --no-cache-dir \
        einops==0.8.0 \
        packaging==24.2 \
        ninja==1.11.1.3 \
        psutil \
        triton==3.4.0 \
        transformers==4.49.0 \
        wandb==0.19.6 \
        numpy==1.26.0 \
        pandas==2.1.4 \
        omegaconf==2.3.0 \
        hydra-core==1.3.2 \
        pytorch-lightning==2.5.0.post0

    # ---- mamba_ssm / causal-conv1d, compiled from source ----------------------
    # Prebuilt wheels are tagged by torch MINOR version only (e.g.
    # "cu12torch2.8"), but their compiled .so links against specific internal
    # libtorch C++ symbols (c10::cuda::SetDevice, etc.) that can differ across
    # patch builds — a wheel built against a torch2.8 dev/rc snapshot can fail
    # with "undefined symbol" against the official 2.8.0 stable release
    # installed above. Building from source compiles against the exact
    # installed torch, avoiding that entirely.
    #
    # KNOWN DEVIATION FROM UPSTREAM: JanusDNA's own README pins mamba_ssm to
    # 2.2.4 (a prebuilt cu12/torch2.5 wheel) and janusdna.yml pins
    # causal-conv1d to 1.5.0.post8 — both older than what's installed below
    # (2.3.1 / 1.7.0). This isn't optional: checked each version's
    # setup.py directly — 2.2.4 / 1.5.0.post8 only emit -gencode flags up to
    # sm_90 (Hopper), with no sm_100/sm_120 (Blackwell) case at all, so they
    # CANNOT target Blackwell regardless of CUDA toolkit version. The
    # versions installed below gate sm_100/sm_120 behind
    # `bare_metal_version >= 12.8`, which this image's CUDA 12.8.1 satisfies.
    # So pinning back to upstream's versions would silently drop Blackwell
    # support, not just carry version risk. The one open question is
    # numerical parity: these newer kernels are API-compatible with what
    # JanusDNA's checkpoints were trained against, but haven't been verified
    # to produce identical outputs — worth a sanity check against a known
    # embedding if exact parity matters for your use case. TORCH_CUDA_ARCH_LIST covers
    # Ampere/Hopper/Blackwell so the same .sif runs on any of them; this makes
    # the build noticeably slower (compiling multiple archs) but is a one-time
    # cost. *_FORCE_BUILD=TRUE stops their setup.py from trying to fetch a
    # prebuilt wheel itself. MAX_JOBS caps parallel nvcc/ninja workers — torch's
    # cpp_extension defaults this to os.cpu_count(), and each nvcc process
    # compiling these CUDA kernels for 4 architectures at once can use several
    # GB of RAM; on a many-core build host that OOMs ninja with a bare
    # "returned non-zero exit status 1" and no compiler error shown. 2 is
    # conservative — raise it if the build host has RAM to spare and you want
    # this faster.
    export TORCH_CUDA_ARCH_LIST="8.0 8.6 9.0 12.0+PTX"
    export CAUSAL_CONV1D_FORCE_BUILD=TRUE
    export MAMBA_FORCE_BUILD=TRUE
    export MAX_JOBS=2
    # --no-deps: both packages' setup.py declare install_requires=["torch", ...]
    # with NO version pin. Without --no-deps, pip is free to resolve that bare
    # "torch" however it likes for this install command and can silently pull
    # a different torch build from PyPI (observed: it replaced the explicit
    # torch==2.8.0+cu128 above with 2.14.0+cu130) — the extension then gets
    # compiled against whichever torch is active at that moment, and if it's
    # not the one active later at import time, you get an ABI mismatch like
    # "undefined symbol: ...c10_cuda_check_implementation..." at import.
    # Their other runtime deps (einops, packaging, ninja, psutil, triton) are
    # already installed above, so --no-deps here doesn't lose anything.
    #
    # mamba-ssm==2.3.1, not the newer 2.3.2.post1: 2.3.2 added a "Mamba-3"
    # module that mamba_ssm/__init__.py imports unconditionally, and that
    # module calls triton.set_allocator() (needs triton>=3.3.0, and
    # mamba-ssm 2.3.2.post1's own install_requires wants triton>=3.5.0) —
    # but torch==2.8.0 itself pins triton==3.4.0 exactly, so 3.5.0+ and
    # torch's own pin can't both be satisfied. JanusDNA's modeling_janusdna.py
    # only ever imports mamba_ssm.ops.selective_scan_interface (Mamba1/2
    # kernels) — Mamba-3 is unused dead weight here, same as flash-attn.
    # 2.3.1 (one release before Mamba-3 landed) doesn't import mamba3 at all,
    # has no triton version floor, and still has the same sm_100/sm_120
    # Blackwell gencode gating in its setup.py as 2.3.2.post1 — so this loses
    # nothing needed here while sidestepping the triton conflict entirely.
    pip install --no-cache-dir --no-build-isolation --no-deps causal-conv1d==1.7.0
    pip install --no-cache-dir --no-build-isolation --no-deps mamba-ssm==2.3.1

    # selene-sdk is installed without deps, per the JanusDNA README
    pip install --no-cache-dir selene-sdk --no-deps

    # ---- JanusDNA source ------------------------------------------------------
    git clone --depth 1 https://github.com/Qihao-Duan/JanusDNA.git /opt/JanusDNA

    # Byte-compile check (non-fatal)
    python -c "import torch; print('torch', torch.__version__)" || true

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/opt/venv/bin:$PATH
    export VIRTUAL_ENV=/opt/venv
    export PYTHONNOUSERSITE=1
    export PYTHONPATH=/opt/JanusDNA:$PYTHONPATH
    # Keep HF/torch caches inside the bound working dir by default
    export HF_HOME=${HF_HOME:-$PWD/.hf_cache}

%runscript
    exec python "$@"

%test
    . /opt/venv/bin/activate
    python - <<'PY'
import torch, mamba_ssm, causal_conv1d
print("torch:", torch.__version__, "| CUDA build:", torch.version.cuda)
print("torch arch list:", torch.cuda.get_arch_list())
print("mamba_ssm + causal_conv1d import OK (built from source, no flash-attn — see module docstring)")
print("CUDA available at test time:", torch.cuda.is_available())

# Actually import the janusdna package extract_embeddings_JanusDNA.py needs,
# so a missing/mismatched dep (e.g. wandb, transformers) fails the build
# instead of surfacing later at the first real run.
import sys
sys.path.insert(0, "/opt/JanusDNA")
from janusdna.configuration_janusdna import JanusDNAConfig
from janusdna.modeling_janusdna import JanusDNAModel
print("janusdna.configuration_janusdna / modeling_janusdna import OK")
PY

%labels
    Application JanusDNA
    Description Bi-directional hybrid DNA foundation model (conda-free container)
    Python 3.11
    PyTorch 2.8.0+cu128
    Source https://github.com/Qihao-Duan/JanusDNA

%help
    Conda-free Apptainer container for JanusDNA.

    Build:
        apptainer build janusdna.sif janusdna.def
    Run:
        apptainer run   --nv janusdna.sif                  # launches python
        apptainer exec  --nv janusdna.sif python script.py
        apptainer shell --nv janusdna.sif

    Notes:
      * Requires an NVIDIA GPU + driver on the host; pass --nv.
      * mamba_ssm/causal-conv1d are compiled from source at build time
        targeting Ampere/Hopper/Blackwell (sm_80/86/90/120), so the same
        .sif runs on any of them — no flash-attn (unused, see module
        docstring). Check your GPU's compute capability with:
            apptainer exec --nv janusdna.sif nvidia-smi --query-gpu=name,compute_cap --format=csv
      * JanusDNA source is at /opt/JanusDNA (already on PYTHONPATH).
      * Download pretrained weights from the Harvard Dataverse link in the
        JanusDNA README and bind-mount them at runtime, e.g.:
            apptainer exec --nv -B /path/to/weights:/weights janusdna.sif \
                python /opt/JanusDNA/your_embedding_script.py