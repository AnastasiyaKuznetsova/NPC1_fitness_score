Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

# =============================================================================
# AlphaGenome — Apptainer/Singularity container for extract_embeddings_AlphaGenome.py
#
# Targets NVIDIA RTX PRO 6000 (Blackwell, sm_120, 96 GB). Blackwell needs
# CUDA >= 12.8 and an R570+ host driver; JAX gained functional RTX PRO 6000
# support in 0.6.2, so jax[cuda12] is floored there.
#
# WHY THIS IS A JAX IMAGE, NOT A PYTORCH ONE
#   The hosted AlphaGenome API only returns track predictions and variant
#   scores — it never returns hidden states. Embeddings require running the
#   model locally from the research release (google-deepmind/alphagenome_research),
#   which is JAX/Haiku. torch is still installed, but CPU-only: the extraction
#   script uses it solely for the shared pool()/pool_downstream() helpers in
#   embedding_utils.py, which run on numpy-sized arrays after the JAX forward
#   pass. Keeping torch on the CPU wheel avoids a second full CUDA stack in
#   the image and stops torch and JAX fighting over GPU memory.
#
# UBUNTU 24.04 / PYTHON 3.12
#   alphagenome_research requires Python >= 3.11 and current jax requires
#   >= 3.12, so this is based on 24.04 (python3.12) rather than the 22.04
#   (python3.10) used by def/dnabert2.def. 24.04 marks the system Python as
#   externally managed (PEP 668), so everything is installed into a venv at
#   /opt/venv which %environment puts first on PATH.
#
# TENSORFLOW
#   alphagenome_research declares tensorflow as a hard dependency, but it is
#   imported only by io/dataset.py and io/bundles.py — the training/finetuning
#   tf.data pipeline. The inference path used here
#   (alphagenome_research.model.dna_model -> io.genome, io.splicing) never
#   imports it, so it is dead weight at runtime and will not compete with JAX
#   for the GPU. It is installed anyway so that `pip install` resolves cleanly.
#
# BUILD (needs sudo/root or --fakeroot):
#   apptainer build sif/alphagenome.sif def/alphagenome.def
#
# RUN (from the Genomic_model directory, so scripts/output are visible).
# Weights are gated behind non-commercial terms — accept them once at
# https://huggingface.co/google/alphagenome-all-folds, then export a token so
# the container's huggingface_hub.whoami() succeeds non-interactively
# (Apptainer forwards the host environment unless you pass --cleanenv):
#
#   export HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
#   apptainer exec --nv --bind "$PWD":"$PWD" --pwd "$PWD" sif/alphagenome.sif \
#       python3 extract_embeddings_AlphaGenome.py \
#           --ref-file output/20260831_133902/ref_seq_DNA_forward_16384bp.npy \
#           --mut-file output/20260831_133902/mut_seq_DNA_forward_16384bp.npy
#
# For Kaggle weights instead (--source kaggle), export KAGGLE_USERNAME and
# KAGGLE_KEY the same way.
# =============================================================================

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3.12-dev \
        build-essential ca-certificates git \
        zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev libssl-dev
    rm -rf /var/lib/apt/lists/*

    # PEP 668: Ubuntu 24.04's system Python is externally managed, so build a
    # venv rather than fighting apt.
    python3.12 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel

    # AlphaGenome research release (JAX/Haiku model code + weight loaders).
    # Pulls in alphagenome, dm-haiku, orbax-checkpoint, chex, jmp, optax,
    # huggingface_hub, kagglehub, pyBigWig, pyranges, tensorflow, ...
    /opt/venv/bin/pip install --no-cache-dir \
        "git+https://github.com/google-deepmind/alphagenome_research.git"

    # Force the CUDA 12 build of JAX *after* the line above, so the plain CPU
    # jaxlib that alphagenome_research's 'jax' dependency resolves to gets
    # replaced. jax[cuda12] ships self-contained nvidia-*-cu12 pip wheels
    # (CUDA 12.8+), which is what gives sm_120 kernels; the host only needs a
    # matching driver, supplied by `apptainer exec --nv`.
    /opt/venv/bin/pip install --no-cache-dir --upgrade "jax[cuda12]>=0.6.2"

    # CPU-only torch — used exclusively by embedding_utils.pool/pool_downstream.
    /opt/venv/bin/pip install --no-cache-dir \
        torch --index-url https://download.pytorch.org/whl/cpu

    # Remaining direct imports of extract_embeddings_AlphaGenome.py /
    # prepare_dataset.py that aren't already pulled in above.
    /opt/venv/bin/pip install --no-cache-dir \
        numpy "pandas<3" biopython requests openpyxl

    /opt/venv/bin/pip check || true

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONUNBUFFERED=1
    export PATH=/opt/venv/bin:$PATH
    # Apptainer auto-binds the host $HOME; without these, the venv's python can
    # pick up packages from the host's ~/.local user-site (built for a
    # different python/glibc) and shadow the ones installed above.
    export PYTHONNOUSERSITE=1
    unset PYTHONPATH
    # Keep the ~1-4 GB of AlphaGenome weights inside the bound working dir
    # rather than in the host $HOME.
    export HF_HOME=${HF_HOME:-$PWD/.hf_cache}
    export KAGGLEHUB_CACHE=${KAGGLEHUB_CACHE:-$PWD/.kaggle_cache}
    # JAX preallocates ~75% of VRAM by default. That is fine on a dedicated
    # RTX PRO 6000 (96 GB) and avoids fragmentation across the per-batch
    # forward passes; override at run time if you are sharing the card:
    #   XLA_PYTHON_CLIENT_PREALLOCATE=false
    #   XLA_PYTHON_CLIENT_MEM_FRACTION=0.5

%runscript
    exec python3 "$@"

%test
    # Runs at build time, where there is no GPU and no --nv, so this only
    # checks that the stack imports and reports which backend JAX picked.
    /opt/venv/bin/python - <<'PY'
import jax, jaxlib, haiku, torch
import alphagenome, alphagenome_research
from alphagenome_research.model import dna_model
print("jax:", jax.__version__, "| jaxlib:", jaxlib.__version__)
print("backend:", jax.default_backend(), "| devices:", jax.devices())
print("haiku:", haiku.__version__)
print("alphagenome_research:", alphagenome_research.__version__)
print("torch:", torch.__version__, "(CPU build, used only for pooling)")
print("trunk loader present:", hasattr(dna_model, "create_from_huggingface"))
PY

%labels
    Application AlphaGenome
    Description Environment for AlphaGenome embedding extraction (JAX/Haiku)
    Python 3.12
    JAX cuda12 >=0.6.2
    GPU Blackwell sm_120 (RTX PRO 6000)
    Source https://github.com/google-deepmind/alphagenome_research

%help
    Apptainer container for extract_embeddings_AlphaGenome.py, built for
    NVIDIA RTX PRO 6000 (Blackwell / sm_120) on CUDA 12.8.

    Build:
        apptainer build sif/alphagenome.sif def/alphagenome.def

    Check the GPU is visible before a long run:
        apptainer exec --nv sif/alphagenome.sif \
            python3 -c "import jax; print(jax.devices())"
    Expect a CudaDevice, not CpuDevice. If you get CpuDevice, the host driver
    is probably older than R570 or --nv was omitted.

    Run (transformer-tower embeddings, the script's default):
        export HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
        apptainer exec --nv --bind "$PWD":"$PWD" --pwd "$PWD" \
            sif/alphagenome.sif python3 extract_embeddings_AlphaGenome.py \
                --ref-file output/<run>/ref_seq_DNA_forward_16384bp.npy \
                --mut-file output/<run>/mut_seq_DNA_forward_16384bp.npy

    Notes:
      * Weights are gated: accept the non-commercial terms once at
        https://huggingface.co/google/alphagenome-all-folds (or the Kaggle
        equivalent) and export HF_TOKEN / KAGGLE_USERNAME+KAGGLE_KEY.
        Apptainer forwards the host environment unless you pass --cleanenv.
        The first run downloads the checkpoint into $HF_HOME (defaults to
        ./.hf_cache), so it needs network access; later runs are offline.
      * DeepMind's stated minimum for inference is an H100. The RTX PRO 6000's
        96 GB is comfortable at the 16KB input length; --extract-from 1bp at
        --model-seq-length 1048576 materialises ~6.4 GB per sequence, so keep
        --batch-size 1 there.
      * If the bundled CUDA pip wheels clash with the image's system CUDA,
        rebuild with jax[cuda12-local] instead of jax[cuda12] to link against
        /usr/local/cuda from the base image.
      * torch is the CPU wheel on purpose — it is only used for the shared
        pooling helpers in embedding_utils.py, never for the model.
      * To pin this image for reproducibility, run
            apptainer exec sif/alphagenome.sif pip freeze > alphagenome_pins.txt
        and feed that back in with `pip install -r`.
