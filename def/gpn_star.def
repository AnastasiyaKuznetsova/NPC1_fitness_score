Bootstrap: docker
From: nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

# =============================================================================
# GPN-Star — Apptainer/Singularity container
#
# Unlike Caduceus/JanusDNA, GPN-Star needs no compiled CUDA kernels (no
# mamba_ssm/causal-conv1d) — it's a plain pip install, but the `gpn` package
# itself pins `requires-python = ">=3.13,<3.14"` (see songlab-cal/gpn's
# pyproject.toml) and `transformers==5.15.0` exactly, both newer than what
# the other .def files here use, hence its own container. Covers both:
#   - gpn_star_score.py       (queries precomputed songlab/gpn-star-scores
#                              Parquet shards over HTTP — needs pyarrow +
#                              fsspec[http], no `gpn` package or GPU)
#   - extract_embeddings_GPN_Star.py (runs the actual GPN-Star model against
#                              a local GPN-Star MSA store — needs `gpn` +
#                              torch + zarr, and a GPU for real workloads)
#
# BUILD (needs sudo/root or --fakeroot):
#   apptainer build gpn_star.sif gpn_star.def
#
# RUN (from the Genomic_model directory, so scripts/output are visible):
#   apptainer exec --bind "$PWD":"$PWD" --pwd "$PWD" gpn_star.sif \
#       python3 gpn_star_score.py
#   apptainer exec --nv --bind "$PWD":"$PWD" --pwd "$PWD" gpn_star.sif \
#       python3 extract_embeddings_GPN_Star.py --msa-path /path/to/hg38_cactus447way \
#       --variant-meta-file output/.../variant_meta_512bp.csv
#
# gpn_star_score.py only reads remote Parquet over HTTP (no model, no GPU),
# so --nv is not needed for it. extract_embeddings_GPN_Star.py runs the
# actual model and needs --nv for a real (non-CPU-fallback) run.
# =============================================================================

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        software-properties-common \
        ca-certificates wget curl git \
        build-essential

    # Python 3.13 — gpn's pyproject.toml pins requires-python ">=3.13,<3.14"
    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get update
    apt-get install -y --no-install-recommends \
        python3.13 python3.13-venv python3.13-dev
    rm -rf /var/lib/apt/lists/*

    python3.13 -m venv /opt/venv
    . /opt/venv/bin/activate
    python -m pip install --no-cache-dir --upgrade pip setuptools wheel

    # torch built for CUDA 12.8, with native Blackwell (sm_120) support —
    # installed before `gpn` so its unpinned "torch>=2.5" dependency is
    # already satisfied by this build instead of pulling a generic PyPI wheel.
    pip install --no-cache-dir \
        torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0 \
        --index-url https://download.pytorch.org/whl/cu128

    # gpn[inference]: pulls transformers==5.15.0, datasets, accelerate,
    # biopython, pandas, pyarrow, zarr (see songlab-cal/gpn's pyproject.toml).
    pip install --no-cache-dir "gpn[inference]"

    # fsspec's HTTP filesystem backend (used by gpn_star_score.py's remote
    # Parquet range-queries) needs aiohttp, which is not pulled in by default.
    pip install --no-cache-dir "fsspec[http]" aiohttp requests

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PATH=/opt/venv/bin:$PATH
    export VIRTUAL_ENV=/opt/venv
    export PYTHONNOUSERSITE=1
    export PYTHONUNBUFFERED=1
    # Keep HF/torch caches inside the bound working dir by default
    export HF_HOME=${HF_HOME:-$PWD/.hf_cache}

%runscript
    exec python "$@"

%test
    . /opt/venv/bin/activate
    python - <<'PY'
import torch, transformers, zarr, fsspec, pyarrow
import gpn
print("torch:", torch.__version__, "| CUDA available:", torch.cuda.is_available())
print("transformers:", transformers.__version__)
print("zarr:", zarr.__version__, "| pyarrow:", pyarrow.__version__)
print("gpn:", gpn.__version__ if hasattr(gpn, "__version__") else "(no __version__ attr)")

from gpn import register_auto_classes
from gpn.data import Tokenizer, ReverseComplementer
from gpn.star.data import GenomeMSA
from gpn.star.utils import find_directory_sum_paths
print("gpn.star imports OK")
PY

%labels
    Application GPN-Star
    Description Environment for GPN-Star precomputed-score lookups and embedding extraction
    Python 3.13
    PyTorch 2.8.0+cu128
    Source https://github.com/songlab-cal/gpn

%help
    Apptainer container for GPN-Star (songlab-cal/gpn), covering both
    gpn_star_score.py (precomputed-score lookup, CPU-only) and
    extract_embeddings_GPN_Star.py (actual model embeddings, GPU).

    Build:
        apptainer build gpn_star.sif gpn_star.def
    Run:
        apptainer exec --bind "$PWD":"$PWD" --pwd "$PWD" gpn_star.sif \
            python3 gpn_star_score.py
        apptainer exec --nv --bind "$PWD":"$PWD" --pwd "$PWD" gpn_star.sif \
            python3 extract_embeddings_GPN_Star.py --msa-path /path/to/msa \
            --variant-meta-file output/.../variant_meta_512bp.csv

    Notes:
      * --nv is only needed for extract_embeddings_GPN_Star.py (model forward
        passes); gpn_star_score.py just range-queries remote Parquet files.
      * Both scripts need network access at runtime: gpn_star_score.py to
        stream https://huggingface.co/datasets/songlab/gpn-star-scores, and
        extract_embeddings_GPN_Star.py (on first run) to download the HF
        model weights — the MSA store itself (--msa-path) must already be
        on local/shared disk (see extract_embeddings_GPN_Star.py's docstring
        for where to get it: https://huggingface.co/datasets/songlab/hg38_cactus447way).
      * gpn's own pyproject.toml pins Python to >=3.13,<3.14 and
        transformers==5.15.0 exactly — do not try to reuse dnabert2.sif/
        caduceus.sif's Python 3.10/3.11 environments for these scripts.
